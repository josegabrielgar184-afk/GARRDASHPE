rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Role helper functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && userDoc().rol == 'admin';
    }

    function isOperatorOrAdmin() {
      return isSignedIn() && (userDoc().rol == 'admin' || userDoc().rol == 'operador');
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Privileged fields that regular users must never modify on their own doc
    function privilegedUserFields() {
      return ['rol', 'vip', 'vipExpiry', 'banned', 'bannedDate', 'bannedReason'];
    }

    function noPrivilegedFieldChanged() {
      return request.resource.data.diff(resource.data)
        .affectedKeys().hasOnly(
          // Allow all non-privileged fields. If a privileged field is in the
          // affected keys, the rule below blocks it.
          request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(privilegedUserFields()) == false
        );
    }

    // --- usuarios collection ---
    // Users can read any profile (rankings, search). Users can create/update
    // their own doc but CANNOT change rol, vip, banned, vipExpiry, bannedDate.
    // Admins can update any user including privileged fields.
    match /usuarios/{uid} {
      allow read: if isSignedIn();

      allow create: if isOwner(uid)
        && request.resource.data.rol == 'jugador';

      allow update: if isAdmin()
        || (isOwner(uid)
          && request.resource.data.rol == resource.data.rol
          && request.resource.data.vip == resource.data.vip
          && request.resource.data.banned == resource.data.banned
          && !(request.resource.data.diff(resource.data)
                .affectedKeys().hasAny(['rol', 'vip', 'vipExpiry', 'banned', 'bannedDate', 'bannedReason']))
        );

      allow delete: if false;
    }

    // --- canjes (pending review queue) ---
    // Owner can create & read. Owner can delete only if still pending.
    // Admin/operator can read all, update status, delete.
    match /canjes/{canjeId} {
      allow read: if isOwner(resource.data.userId) || isOperatorOrAdmin();
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending_review';
      allow update: if isOperatorOrAdmin();
      allow delete: if (isOwner(resource.data.userId)
          && (resource.data.status == 'pending_review' || resource.data.status == 'waiting_correction'))
        || isOperatorOrAdmin();
    }

    // --- canjes_aprobadas (immutable history) ---
    match /canjes_aprobadas/{canjeId} {
      allow read: if isOwner(resource.data.userId) || isOperatorOrAdmin();
      allow create: if isOperatorOrAdmin();
      allow update: if false;
      allow delete: if false;
    }

    // --- canjes_rechazadas (immutable history) ---
    match /canjes_rechazadas/{canjeId} {
      allow read: if isOwner(resource.data.userId) || isOperatorOrAdmin();
      allow create: if isOperatorOrAdmin();
      allow update: if false;
      allow delete: if false;
    }

    // --- notificaciones ---
    // Users read their own. Anyone signed in can create (system writes to
    // other users). Users can update their own (mark as read).
    match /notificaciones/{notifId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isSignedIn();
      allow update: if isOwner(resource.data.userId);
      allow delete: if isOwner(resource.data.userId);
    }

    // --- config (global app config) ---
    // Only admin/operator can write. Anyone signed in can read.
    match /config/{docId} {
      allow read: if isSignedIn();
      allow write: if isOperatorOrAdmin();
    }

    // --- admin_income (manual income records) ---
    match /admin_income/{incomeId} {
      allow read: if isOperatorOrAdmin();
      allow create: if isOperatorOrAdmin();
      allow update: if isOperatorOrAdmin();
      allow delete: if isOperatorOrAdmin();
    }

    // --- logs_operadores (operator audit log) ---
    match /logs_operadores/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    // --- scores (public leaderboards) ---
    // Authenticated users can create & read. No updates or deletes.
    match /scores_space/{scoreId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }
    match /scores_zombies/{scoreId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }
    match /scores_survival/{scoreId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    // --- solicitudes_pendientes / confirmadas (operator prize queue) ---
    match /solicitudes_pendientes/{reqId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isOperatorOrAdmin();
      allow delete: if isOperatorOrAdmin();
    }
    match /solicitudes_confirmadas/{reqId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    // --- Creator Program ---
    // creator_applications: owner can read own & create. Admin can read all, update status.
    match /creator_applications/{appId} {
      allow read: if isOwner(resource.data.uid) || isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isAdmin();
      allow delete: if false;
    }

    // creator_codes: anyone signed in can read (needed to validate code entry).
    // Admin can create (via approval flow) and update (suspend/reactivate).
    //
    // CONTRADICTION: applyReferralCode and checkAndQualifyReferral run from
    // the client and update counters (totalReferrals, pendingQualification,
    // qualified, coinsEarned, qualifiedThisMonth) via Firestore transactions.
    // These transaction writes come from the referred user's client, not admin.
    // If rules say "allow update: if isAdmin()", the qualification flow BREAKS.
    //
    // OPTIONS:
    //   A) allow update for any signed-in user → works but any user can modify
    //      counters (CLIENT-TRUST on counter integrity)
    //   B) allow update only for admin → secure counters but breaks qualification
    //   C) Move qualification to a Cloud Function → not available now
    //
    // Current choice: A) with documented CLIENT-TRUST on counter integrity.
    // The transaction prevents double-paying creators, but does NOT prevent
    // a malicious user from inflating their own creator counters.
    // The coinsEarned field is display-only — actual coin credits go to
    // usuarios/{creatorUid}.coins via the same transaction, and that field
    // is protected by usuarios rules.
    match /creator_codes/{codeId} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow update: if isSignedIn();
      allow delete: if false;
    }

    // creator_referrals: owner (referred user) and creator can read.
    // System creates on code application. Update restricted to activeDays only
    // (day-tracking array). All economic fields are client-trust — see report.
    // The transaction in checkAndQualifyReferral writes creatorRewardPaid, status,
    // qualifiedAt, and creator_codes counters from the client. Firestore Rules
    // cannot distinguish a transaction write from a regular write, so restricting
    // update to only activeDays would BREAK the qualification flow.
    //
    // TRADE-OFF: allow update for the referred user (needed for qualification
    // transaction to work), but restrict to ONLY the referred user — not any
    // authenticated user.
    match /creator_referrals/{refId} {
      allow read: if isOwner(resource.data.referredUid)
        || (isSignedIn() && get(/databases/$(database)/documents/creator_referrals/$(refId)).data.creatorUid == request.auth.uid)
        || isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.referredUid == request.auth.uid;
      // Only the referred user can update their own referral record.
      // The creator cannot modify it. Other users cannot access it.
      // This is necessary because the qualification transaction runs from
      // the referred user's client. Economic field protection is CLIENT-TRUST.
      allow update: if isOwner(resource.data.referredUid);
      allow delete: if false;
    }

    // --- Default deny ---
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
